# Groq API Key for Cloud LLM Mode (Get key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# LLM Provider ("cloud" or "local")
LLM_PROVIDER=cloud

# Cloud Groq Model
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama Model
LLM_MODEL=qwen2.5:7b

# Embedding Microservice URL (used inside Docker)
EMBEDDING_SERVICE_URL=http://embedding_service:8001/embed
